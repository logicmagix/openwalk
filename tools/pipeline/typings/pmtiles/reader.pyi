# Local type stubs for the parts of the pmtiles package the pipeline uses; the
# package itself ships without type information for these modules.
from collections.abc import Callable, Iterator
from typing import Any

GetBytes = Callable[[int, int], bytes]

class MemorySource:
    def __init__(self, buf: bytes) -> None: ...
    def __call__(self, offset: int, length: int) -> bytes: ...

class MmapSource:
    def __init__(self, f: Any) -> None: ...
    def __call__(self, offset: int, length: int) -> bytes: ...

class Reader:
    get_bytes: GetBytes
    def __init__(self, get_bytes: GetBytes) -> None: ...
    def header(self) -> dict[str, Any]: ...
    def metadata(self) -> dict[str, Any]: ...
    def get(self, z: int, x: int, y: int) -> bytes | None: ...

def all_tiles(get_bytes: GetBytes) -> Iterator[tuple[tuple[int, int, int], bytes]]: ...
