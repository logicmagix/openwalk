{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwalk.app/schemas/site.schema.json",
  "title": "Site configuration",
  "description": "The hand-written site.yaml that describes one site: identity, boundary, default view, and how the pipeline selects walkways.",
  "type": "object",
  "required": ["id", "name", "boundary"],
  "properties": {
    "id": {
      "description": "Directory name under sites/ and the site segment of share URLs.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "boundary": {
      "description": "The area OpenStreetMap data is fetched for. Exactly one of the three forms.",
      "oneOf": [
        {
          "type": "object",
          "required": ["osm_way"],
          "properties": { "osm_way": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["osm_relation"],
          "properties": { "osm_relation": { "type": "integer", "minimum": 1 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["bbox"],
          "properties": { "bbox": { "$ref": "#/$defs/bbox" } },
          "additionalProperties": false
        }
      ]
    },
    "view": {
      "description": "Where the map opens before a position is known.",
      "type": "object",
      "required": ["center", "zoom"],
      "properties": {
        "center": { "$ref": "#/$defs/position" },
        "zoom": { "type": "number", "minimum": 0, "maximum": 24 }
      },
      "additionalProperties": false
    },
    "walkways": {
      "description": "Which OpenStreetMap highway values count as walkways for this site.",
      "type": "object",
      "properties": {
        "highway": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "attribution": { "type": "string" }
  },
  "additionalProperties": true,
  "$defs": {
    "position": {
      "description": "Longitude then latitude, as GeoJSON orders them.",
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "bbox": {
      "description": "South, west, north, east in degrees, the order Overpass uses.",
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 }
      ],
      "minItems": 4,
      "maxItems": 4
    }
  }
}
