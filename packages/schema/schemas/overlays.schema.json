{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwalk.app/schemas/overlays.schema.json",
  "title": "Overlays",
  "description": "The generated overlays.json: each georeferenced image a site offers as a map layer, with the geographic position of its four corners.",
  "type": "object",
  "required": ["overlays"],
  "properties": {
    "overlays": { "type": "array", "items": { "$ref": "#/$defs/overlay" } }
  },
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "overlay": {
      "type": "object",
      "required": ["id", "name", "image", "width", "height", "corners"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "image": {
          "description": "Path relative to the site directory.",
          "type": "string",
          "minLength": 1
        },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "corners": {
          "description": "Top-left, top-right, bottom-right, bottom-left of the image.",
          "type": "array",
          "items": { "$ref": "#/$defs/position" },
          "minItems": 4,
          "maxItems": 4
        },
        "attribution": { "type": "string" },
        "fit": {
          "description": "How well the control points agree with the fitted transform, in metres. Absent for an image whose corners are known exactly, such as an aerial photograph fetched for them.",
          "type": "object",
          "required": ["control_points", "rms_m", "max_m"],
          "properties": {
            "control_points": { "type": "integer", "minimum": 3 },
            "rms_m": { "type": "number", "minimum": 0 },
            "max_m": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
