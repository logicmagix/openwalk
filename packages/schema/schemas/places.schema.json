{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwalk.app/schemas/places.schema.json",
  "title": "Places",
  "description": "The generated places.geojson: one Point per curated place, positioned at its entrance when one is known.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": { "type": "array", "items": { "$ref": "#/$defs/place" } }
  },
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "place": {
      "type": "object",
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Point" },
            "coordinates": { "$ref": "#/$defs/position" }
          },
          "additionalProperties": false
        },
        "properties": {
          "type": "object",
          "required": ["name", "category", "keywords", "verified"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "number": { "type": "string", "minLength": 1 },
            "category": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "annotation": { "type": "string" },
            "keywords": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "osm_id": { "type": "string", "pattern": "^(node|way|relation)/[0-9]+$" },
            "verified": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
