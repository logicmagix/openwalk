{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwalk.app/schemas/walkways.schema.json",
  "title": "Walkways",
  "description": "The generated walkways.geojson: every way a pedestrian may use, as a GeoJSON FeatureCollection. Linear ways are LineStrings; pedestrian areas such as plazas are Polygons.",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": { "const": "FeatureCollection" },
    "features": { "type": "array", "items": { "$ref": "#/$defs/walkway" } }
  },
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "lineString": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "LineString" },
        "coordinates": { "type": "array", "items": { "$ref": "#/$defs/position" }, "minItems": 2 }
      },
      "additionalProperties": false
    },
    "polygon": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": {
          "type": "array",
          "items": { "type": "array", "items": { "$ref": "#/$defs/position" }, "minItems": 4 },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "walkway": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "properties": {
        "type": { "const": "Feature" },
        "id": { "type": "string" },
        "geometry": { "oneOf": [{ "$ref": "#/$defs/lineString" }, { "$ref": "#/$defs/polygon" }] },
        "properties": {
          "type": "object",
          "required": ["osm_id", "highway"],
          "properties": {
            "osm_id": {
              "description": "OpenStreetMap element reference, for example way/123.",
              "type": "string",
              "pattern": "^(node|way|relation)/[0-9]+$"
            },
            "highway": { "type": "string" },
            "name": { "type": "string" },
            "surface": { "type": "string" },
            "lit": { "type": "string" },
            "incline": { "type": "string" },
            "step_count": { "type": "integer", "minimum": 1 },
            "wheelchair": { "type": "string" },
            "covered": { "type": "string" },
            "level": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
