# Editor settings that most editors read natively. Prettier enforces the same
# rules for code; this file covers everything else (YAML, Markdown, shell).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
